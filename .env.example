# OpenAI-compatible endpoint used only by event-triggered AI roles.
# Store real values only in the ignored local .env or process environment; never commit them.
AI_API_URL=https://api.example.com/v1/chat/completions
AI_API_KEY=replace-me
AI_MODEL=replace-with-a-json-capable-model
XHS_AI_PROMPT_VERSION=1

# Backward-compatible aliases used by the page-recovery wrapper.
VISION_API_URL=https://api.example.com/v1/chat/completions
VISION_API_KEY=replace-me
VISION_MODEL=replace-with-a-vision-model

# Optional review-queue mirror. lark-cli keeps its OAuth token locally.
LARK_RESEARCH_BASE_TOKEN=replace-with-research-base-token
LARK_RESEARCH_TABLE_ID=replace-with-research-table-id

# Legacy device-inventory table, if that separate pipeline is used.
LARK_BASE_TOKEN=replace-with-inventory-base-token
LARK_TABLE_ID=replace-with-inventory-table-id
