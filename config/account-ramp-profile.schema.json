{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.xhs-device-agent/account-ramp-profile.schema.json",
  "title": "XHS account cold-start read-only profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "accountAlias", "deviceAlias", "deviceGroup", "phase",
    "primaryTopic", "topicPool", "automationPolicy", "interactionPolicy",
    "paused", "phaseApproval"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "accountAlias": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,39}$" },
    "deviceAlias": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "deviceGroup": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)" },
    "phase": {
      "enum": [
        "draft", "device_ready", "profile_ready", "topic_learning",
        "content_preparation", "steady_operation", "human_required", "paused", "retired"
      ]
    },
    "primaryTopic": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)" },
    "topicPool": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)" }
    },
    "automationPolicy": { "const": "research_read_only" },
    "interactionPolicy": { "const": "human_final" },
    "paused": { "type": "boolean" },
    "phaseApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "approved", "approvedAt"],
      "properties": {
        "phase": {
          "enum": [
            "draft", "device_ready", "profile_ready", "topic_learning",
            "content_preparation", "steady_operation", "human_required", "paused", "retired"
          ]
        },
        "approved": { "const": true },
        "approvedAt": { "type": "string", "minLength": 10, "maxLength": 40 }
      }
    }
  }
}
