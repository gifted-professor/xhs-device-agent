{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.xhs-device-agent/composite-capability-acceptance.schema.json",
  "title": "Human acceptance receipt for a production capability profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "acceptanceId",
    "capabilityProfileId",
    "capabilityProfileHash",
    "acceptedBy",
    "acceptedAt",
    "acceptanceEvidenceHash",
    "acceptedLimits"
  ],
  "properties": {
    "schemaVersion": {
      "const": "xhs-composite-capability-acceptance/v1"
    },
    "acceptanceId": {
      "type": "string",
      "pattern": "^acceptance-[a-f0-9]{16}$"
    },
    "capabilityProfileId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"
    },
    "capabilityProfileHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "acceptedBy": {
      "const": "human"
    },
    "acceptedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
    },
    "acceptanceEvidenceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "acceptedLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxDevices",
        "maxParallel",
        "maxStateChangesTotal",
        "maxStateChangesPerMinute",
        "cpaConcurrency",
        "allowedActions"
      ],
      "properties": {
        "maxDevices": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maxParallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maxStateChangesTotal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000000
        },
        "maxStateChangesPerMinute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "cpaConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "allowedActions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "enum": [
              "feed.scroll",
              "feed.open_visible",
              "search.open_results",
              "search.open_result",
              "content.open_xhs_url",
              "research.collect",
              "detail.inspect",
              "detail.evaluate_title_rule",
              "image.scroll_content",
              "video.advance",
              "comments.observe_count",
              "comments.open",
              "comments.collect",
              "comments.close",
              "navigation.return_to_feed",
              "navigation.return_to_source",
              "wait.for_condition",
              "recover.to_feed",
              "engagement.ensure_liked",
              "engagement.ensure_favorited"
            ]
          }
        }
      }
    }
  }
}
