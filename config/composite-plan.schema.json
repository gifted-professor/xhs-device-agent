{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.xhs-device-agent/composite-plan.schema.json",
  "title": "XHS compiled supervised composite plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "policyProfileId",
    "policyHash",
    "capabilityProfileId",
    "capabilityProfileHash",
    "compilerVersion",
    "rng",
    "inventorySnapshotHash",
    "capabilitySnapshotHash",
    "capabilityRequirements",
    "visitPolicy",
    "devices",
    "limits",
    "runtimeProfile",
    "failurePolicyRef",
    "planHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "xhs-composite-plan/v1"
    },
    "planId": {
      "type": "string",
      "pattern": "^plan-[a-f0-9]{16}$"
    },
    "policyProfileId": {
      "const": "supervised-composite-v1"
    },
    "policyHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capabilityProfileId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"
    },
    "capabilityProfileHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "compilerVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "rng": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "seed"
      ],
      "properties": {
        "algorithm": {
          "const": "hmac-sha256-counter-v1"
        },
        "seed": {
          "type": "string",
          "minLength": 24,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9+/=_-]+$"
        }
      }
    },
    "inventorySnapshotHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capabilitySnapshotHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capabilityRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionRegistry",
        "commentPolicy",
        "cpaCommentCountSchema"
      ],
      "properties": {
        "actionRegistry": {
          "const": "composite-actions/v1"
        },
        "commentPolicy": {
          "const": "count-adaptive-v1"
        },
        "cpaCommentCountSchema": {
          "const": "cpa-comment-count/v1"
        }
      }
    },
    "visitPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetValidVisitsPerDevice",
        "maxVisitAttemptsPerDevice",
        "maxSkippedTargetsPerDevice",
        "maxFeedScrollsPerAttempt",
        "maxFeedScrollsTotalPerDevice",
        "visibleCandidateCap",
        "imageContentScrolls",
        "videoAdvances",
        "commentPolicyRef",
        "ensureLikedPerDevice",
        "ensureFavoritedPerDevice",
        "eligibleVisitOrdinals"
      ],
      "properties": {
        "targetValidVisitsPerDevice": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxVisitAttemptsPerDevice": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "maxSkippedTargetsPerDevice": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "maxFeedScrollsPerAttempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "maxFeedScrollsTotalPerDevice": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "visibleCandidateCap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "imageContentScrolls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "videoAdvances": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "commentPolicyRef": {
          "const": "count-adaptive-v1"
        },
        "ensureLikedPerDevice": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "ensureFavoritedPerDevice": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "eligibleVisitOrdinals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      }
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "machine",
          "taskId",
          "steps"
        ],
        "properties": {
          "machine": {
            "type": "string",
            "pattern": "^[0-9]{2}$"
          },
          "taskId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stepId",
                "action",
                "params"
              ],
              "properties": {
                "stepId": {
                  "type": "string",
                  "pattern": "^m[0-9]{2}\\.s[0-9]{3}$"
                },
                "action": {
                  "enum": [
                    "feed.scroll",
                    "feed.open_visible",
                    "detail.inspect",
                    "image.scroll_content",
                    "video.advance",
                    "comments.observe_count",
                    "comments.open",
                    "comments.collect",
                    "comments.close",
                    "navigation.return_to_feed",
                    "wait.for_condition",
                    "recover.to_feed",
                    "engagement.ensure_liked",
                    "engagement.ensure_favorited"
                  ]
                },
                "when": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "observationRef",
                    "operator",
                    "value"
                  ],
                  "properties": {
                    "observationRef": {
                      "type": "string",
                      "pattern": "^m[0-9]{2}\\.s[0-9]{3}\\.(status|countBand|pageState|targetState)$"
                    },
                    "operator": {
                      "enum": [
                        "equals",
                        "not_equals"
                      ]
                    },
                    "value": {
                      "enum": [
                        "VERIFIED",
                        "FAILED",
                        "AMBIGUOUS",
                        "ZERO",
                        "ONE_TO_FIVE",
                        "SIX_TO_TWENTY",
                        "TWENTY_ONE_TO_NINETY_NINE",
                        "HUNDRED_PLUS",
                        "UNKNOWN",
                        "ACTIVE",
                        "INACTIVE"
                      ]
                    }
                  }
                },
                "params": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [],
                  "properties": {
                    "visibleRank": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 20
                    },
                    "candidateCap": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 20
                    },
                    "fallback": {
                      "enum": [
                        "feed_scroll_once_then_skip",
                        "skip_target"
                      ]
                    },
                    "policyRef": {
                      "enum": [
                        "count-adaptive-v1"
                      ]
                    },
                    "conditionId": {
                      "enum": [
                        "foreground_xhs",
                        "page_stable",
                        "feed_ready",
                        "detail_ready",
                        "comment_panel_open",
                        "valid_visit_target_not_met"
                      ]
                    },
                    "timeoutMs": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 30000
                    },
                    "strategyId": {
                      "enum": [
                        "back_once_then_verify",
                        "relaunch_once_then_verify"
                      ]
                    },
                    "targetBindingRef": {
                      "type": "string",
                      "pattern": "^m[0-9]{2}\\.s[0-9]{3}\\.target$"
                    },
                    "maxScrolls": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 8
                    },
                    "maxItems": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 50
                    }
                  }
                },
                "operationId": {
                  "type": "string",
                  "pattern": "^operation-[a-f0-9]{16}$"
                },
                "budgetSlotId": {
                  "type": "string",
                  "pattern": "^budget-[a-f0-9]{16}$"
                }
              }
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxParallel",
        "maxStateChangesTotal",
        "maxReadStepsTotal",
        "maxVisionCallsTotal",
        "maxWallClockMs"
      ],
      "properties": {
        "maxParallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maxStateChangesTotal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "maxReadStepsTotal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "maxVisionCallsTotal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "maxWallClockMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 86400000
        }
      }
    },
    "runtimeProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validationMode",
        "startPolicy",
        "readyDeadlineMs",
        "minReady",
        "snapshotReuseMs",
        "readOnlyFlushIntervalMs",
        "readOnlyFlushMaxEvents",
        "cpaWorkflowSoftTimeoutMs"
      ],
      "properties": {
        "validationMode": {
          "const": "startup_strict_runtime_light_account_state_strict"
        },
        "startPolicy": {
          "enum": [
            "all_ready",
            "ready_subset_after_deadline"
          ]
        },
        "readyDeadlineMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "minReady": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "snapshotReuseMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "readOnlyFlushIntervalMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "readOnlyFlushMaxEvents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "cpaWorkflowSoftTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 119999
        }
      }
    },
    "failurePolicyRef": {
      "const": "supervised-failure-policy-v1"
    },
    "planHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
