{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.xhs-device-agent/composite-request.schema.json",
  "title": "XHS supervised composite request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyProfileId",
    "capabilityProfileId",
    "seed",
    "devices",
    "actionPool",
    "recipe",
    "limits"
  ],
  "properties": {
    "schemaVersion": {
      "const": "xhs-composite-request/v1"
    },
    "policyProfileId": {
      "const": "supervised-composite-v1"
    },
    "capabilityProfileId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"
    },
    "seed": {
      "type": "string",
      "minLength": 24,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9+/=_-]+$"
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "machine",
          "taskId"
        ],
        "properties": {
          "machine": {
            "type": "string",
            "pattern": "^[0-9]{2}$"
          },
          "taskId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"
          }
        }
      }
    },
    "actionPool": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "enum": [
          "feed.scroll",
          "feed.open_visible",
          "search.open_results",
          "search.open_result",
          "content.open_xhs_url",
          "research.collect",
          "detail.inspect",
          "detail.evaluate_title_rule",
          "image.scroll_content",
          "video.advance",
          "comments.observe_count",
          "comments.open",
          "comments.collect",
          "comments.close",
          "navigation.return_to_feed",
          "navigation.return_to_source",
          "wait.for_condition",
          "recover.to_feed",
          "engagement.ensure_liked",
          "engagement.ensure_favorited"
        ]
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetValidVisitsPerDevice",
        "maxVisitAttemptsPerDevice",
        "maxSkippedTargetsPerDevice",
        "maxFeedScrollsPerAttempt",
        "maxFeedScrollsTotalPerDevice",
        "visibleCandidateCap",
        "imageContentScrolls",
        "videoAdvances",
        "comments",
        "engagementsPerDevice"
      ],
      "properties": {
        "targetValidVisitsPerDevice": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxVisitAttemptsPerDevice": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "maxSkippedTargetsPerDevice": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "maxFeedScrollsPerAttempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "maxFeedScrollsTotalPerDevice": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "visibleCandidateCap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "imageContentScrolls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "videoAdvances": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "comments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policyRef"
          ],
          "properties": {
            "policyRef": {
              "const": "count-adaptive-v1"
            }
          }
        },
        "engagementsPerDevice": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ensureLiked",
            "ensureFavorited",
            "eligibleVisitOrdinals"
          ],
          "properties": {
            "ensureLiked": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "ensureFavorited": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "eligibleVisitOrdinals": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "min",
                "max"
              ],
              "properties": {
                "min": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "max": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                }
              }
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxParallel",
        "maxStateChangesTotal",
        "maxReadStepsTotal",
        "maxVisionCallsTotal",
        "maxWallClockMs"
      ],
      "properties": {
        "maxParallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maxStateChangesTotal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000000
        },
        "maxReadStepsTotal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "maxVisionCallsTotal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "maxWallClockMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 86400000
        }
      }
    }
  }
}
