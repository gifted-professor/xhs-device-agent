{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.xhs-device-agent/composite-worker-ticket.schema.json",
  "title": "Non-transferable composite worker authorization ticket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ticketId",
    "attemptId",
    "workerId",
    "machine",
    "taskId",
    "planHash",
    "approvalHash",
    "policyHash",
    "capabilityProfileId",
    "capabilityProfileHash",
    "inventorySnapshotHash",
    "capabilitySnapshotHash",
    "allowedStepIds",
    "allowedOperationIds",
    "issuedAt",
    "expiresAt",
    "nonce",
    "parentEpoch"
  ],
  "properties": {
    "schemaVersion": {
      "const": "xhs-composite-worker-ticket/v1"
    },
    "ticketId": {
      "type": "string",
      "pattern": "^ticket-[a-f0-9]{16}$"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^attempt-[a-f0-9]{16}$"
    },
    "workerId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"
    },
    "machine": {
      "type": "string",
      "pattern": "^[0-9]{2}$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"
    },
    "planHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approvalHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policyHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capabilityProfileId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"
    },
    "capabilityProfileHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inventorySnapshotHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capabilitySnapshotHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "allowedStepIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 99999,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^m[0-9]{2}\\.s[0-9]{3,5}$"
      }
    },
    "allowedOperationIds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2000000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^operation-[a-f0-9]{16}$"
      }
    },
    "issuedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
    },
    "expiresAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
    },
    "nonce": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "parentEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    }
  }
}
